# LearnPath AI Backend Configuration

# Set a unique random secret (at least 32 characters) for production.
APP_ENV=development
JWT_SECRET=

# SQLite database file path (or postgresql://user:pass@localhost:5432/learnpath)
DATABASE_URL=sqlite:///./learnpath.db

# Optional Google Gemini API key. Keep it in backend/.env only.
# Without it, live AI Tutor requests return an honest unavailable error.
GEMINI_API_KEY=

# Comma-separated frontend origins; defaults cover local Vite dev and preview.
FRONTEND_ORIGINS=
